# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/wealthos

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# API Configuration
API_PREFIX=/api/v1

# ─── 行情数据 Provider ─────────────────────────────────────────────────────────
# 可选值: mock | tencent | eastmoney | akshare
# mock = 模拟价格（默认），切换到真实 API 时修改此值并取消 marketDataService.js 中对应注释
MARKET_DATA_PROVIDER=mock

# 定时刷新行情的 cron 表达式（时区: Asia/Shanghai）
# 示例: '*/30 * * * *' 每30分钟 | '0 9,12,15 * * 1-5' 工作日三个时点
PRICE_REFRESH_CRON=*/30 * * * *

# ─── AI 分析 Provider ─────────────────────────────────────────────────────────
# 可选值: mock | claude | openai
# mock = 确定性模拟（默认），切换到 LLM 时修改此值并取消 aiService.js 中对应注释
AI_PROVIDER=mock

# Anthropic API Key（AI_PROVIDER=claude 时需要）
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key（AI_PROVIDER=openai 时需要）
# OPENAI_API_KEY=sk-...

# AKShare Bridge URL（AI_PROVIDER=akshare 或 MARKET_DATA_PROVIDER=akshare 时需要）
# AKSHARE_BRIDGE_URL=http://localhost:8001
